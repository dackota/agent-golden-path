{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["name", "team", "owner", "image"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,30}$"},
    "team": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,20}$"},
    "owner": {"type": "string", "minLength": 3},
    "image": {"type": "string", "pattern": "^(ghcr\\.io/suresteel|spike)/[a-z0-9./-]+:[A-Za-z0-9._-]+$",
              "description": "Only images from the allowed registries. No :latest."},
    "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
    "replicas": {"type": "integer", "minimum": 1, "maximum": 5},
    "model": {"type": "string", "enum": ["default-chat", "default-fast"]},
    "systemPrompt": {"type": "string", "maxLength": 20000},
    "gatewayUrl": {"type": "string", "const": "http://litellm.platform-gateway.svc.cluster.local:4000"},
    "extraEgressHosts": {"type": "array", "maxItems": 5, "items": {"type": "string", "enum": ["api.github.com", "api.slack.com"]}},
    "resources": {"type": "object"},
    "autoscaling": {"type": "object", "properties": {
      "maxReplicas": {"type": "integer", "minimum": 1, "maximum": 5},
      "targetCPU": {"type": "integer", "minimum": 50, "maximum": 90}}}
  }
}
